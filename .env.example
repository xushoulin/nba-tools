# Set this to your real domain before deploying (no trailing slash).
# Used for canonical URLs, Open Graph tags, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google AdSense — optional. Leave empty to keep ads disabled (no script is loaded).
# Paste your client id (ca-pub-XXXXXXXXXXXXXXXX) from the AdSense dashboard,
# then rebuild and republish to turn on Auto ads.
NEXT_PUBLIC_ADSENSE_CLIENT=
