# Committed on purpose: Vercel builds from Git, so build-time values must live
# in the repo. Everything below is public — it ends up in the HTML output anyway
# and contains no secrets.

# Canonical origin used by metadata, sitemap.xml, robots.txt and llms.txt.
NEXT_PUBLIC_SITE_URL=https://nba.shoulin.shop

# Google AdSense publisher id. Gated in components/ads/AdSense.tsx and used by
# scripts/gen-ads.mjs to write public/ads.txt at build time.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-2622415797490761

# Google Analytics 4 measurement id. Gated in components/analytics/GoogleAnalytics.tsx:
# empty or malformed values render no script. Found in GA4 > Admin > Data streams >
# nba.shoulin.shop > Measurement ID. Public value, safe to commit.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-K9R2PE5C6B
